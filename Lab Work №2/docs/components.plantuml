@startuml ComponentDiagram

!define RECTANGLE component
!define DATABASE database

title Диаграмма компонентов (Backend)

rectangle Backend as "Сервер (Backend)" {
    component EvaluationModule as "Модуль оценки оборудования" {
        note right of EvaluationModule: Оценка стоимости в зависимости от состояния
    }
    component RulesModule as "Модуль управления правилами оценки" {
        note right of RulesModule: Управление правилами проверки типов оборудования
    }
    component NotificationModule as "Модуль уведомлений" {
        note right of NotificationModule: Уведомление клиентов о результатах
    }
    component APIGateway as "API Gateway" {
        note right of APIGateway: Маршрутизация запросов между модулями
    }
}

APIGateway --> EvaluationModule : "Запросы на оценку"
APIGateway --> RulesModule : "Запросы на правила"
APIGateway --> NotificationModule : "Запросы на уведомления"
EvaluationModule --> Database : "Чтение/запись данных о типах оборудования"
RulesModule --> Database : "Чтение/запись правил проверки"
NotificationModule --> Database : "Запись истории уведомлений"

@enduml
